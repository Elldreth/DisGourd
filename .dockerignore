# Keep the build context small and never bake in host state or secrets.
**/node_modules
web/dist
.git
.github
.claude
data
local
uploads
*.log
npm-debug.log*
server/.jwt-secret
server/config.json
server/db/*.db
server/db/*.db-*
server/db/backups
setup.bat
run.bat
update.bat
.env
.env.*
*.local
# Not needed to build or run the app (and design/ is large).
design
.dev
deploy
# Any database, its WAL/SHM files, or a generated secret, wherever they are.
**/*.db
**/*.db-*
**/.jwt-secret
**/.vapid.json
**/.setup-code
